{
  "name": "gitmag",
  "version": "0.2.9",
  "type": "module",
  "bin": {
    "gitmag": "./dist/index.js"
  },
  "scripts": {
    "prepare": "[ -n \"$CI\" ] || husky",
    "dev": "bun src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "dead-code": "knip",
    "duplication": "jscpd src --min-tokens 80 --threshold 0",
    "audit": "npm install --package-lock-only --ignore-scripts && better-npm-audit audit --level high",
    "version": "npm run build && npx git-cliff -o CHANGELOG.md --config cliff.toml && git add CHANGELOG.md",
    "preversion": "npm run test && npm run lint && npm run build",
    "postversion": "git push --follow-tags"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@inkjs/ui": "^2.0.0",
    "ansi-escapes": "^7.3.0",
    "clipboardy": "^5.3.1",
    "fuse.js": "^7.1.0",
    "ink": "^5.2.1",
    "react": "^18.3.1",
    "simple-git": "^3.33.0"
  },
  "overrides": {
    "vite": ">=8.0.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.4",
    "@commitlint/config-conventional": "^20.4.4",
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.5.0",
    "@types/react": "^18.2.79",
    "@typescript-eslint/eslint-plugin": "^8.57.0",
    "@typescript-eslint/parser": "^8.57.0",
    "@vitest/coverage-v8": "^4.1.1",
    "better-npm-audit": "^3.11.0",
    "ecc-universal": "^1.9.0",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-security": "^4.0.0",
    "eslint-plugin-sonarjs": "^4.0.2",
    "husky": "^9.1.7",
    "ink-testing-library": "^4.0.0",
    "jscpd": "^4.0.8",
    "jsdom": "^28.1.0",
    "knip": "^6.0.1",
    "lint-staged": "^16.3.3",
    "prettier": "^3.8.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  }
}
